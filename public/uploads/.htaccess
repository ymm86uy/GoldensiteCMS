Options -Indexes
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
RemoveType .php .phtml .phar
<FilesMatch "(?i)(^\.|\.(php[0-9]*|phtml|phar|shtml|html?|svg|js|htaccess)(\.|$))">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'; sandbox"
</IfModule>

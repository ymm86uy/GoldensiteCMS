# Configure a dedicated database account. Never expose this file over HTTP.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="goldensite_cms"
DB_USER="goldensite_app"
DB_PASS=""
# Optional application secret, at least 32 random characters. Otherwise a private key is generated in storage/keys.
APP_KEY=""

# auto: require ClamAV when its endpoint is set. Alternatives: required, provider, disabled.
GOLDENSITE_UPLOAD_POLICY="auto"
# Use the local socket or loopback address provisioned for this installation.
GOLDENSITE_CLAMD_ENDPOINT=""
# Optional comma-separated IPs or networks exempt from automatic permanent WAF blocking only.
GOLDENSITE_WAF_AUTOBAN_EXEMPT=""
